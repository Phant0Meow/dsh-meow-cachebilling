{
  "name": "meow-cachebilling",
  "version": "0.6.0",
  "description": "喵账单：上下文圆环弹层里实时算账——一步/一轮/会话三行各带总价，缓存命中/未命中/输出三列明细的无边框小账表，外加当前模型的平均累计花费曲线（帮你赶在花销起飞前换窗口），峰谷/一口价自动计价（价目表 rates.yml 可手填），专治『缓存命中率 100% 却越用越贵』",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "billing",
    "cache-hit",
    "cost",
    "peak-offpeak"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phant0Meow/dsh-meow-cachebilling.git"
  },
  "author": "Phant0Meow",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "rates.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings-plugins"]
    }
  },
  "scripts": {
    "prepare": "node build.mjs",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "esbuild": "^0.25.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
